{
  "version": "0.2.0",
  "configurations": [
    {
      // Without --dart-define-from-file the app builds and launches fine, but
      // MapsConfig.apiKey is the empty string, so venue search and the map
      // picker's address lookup fail at runtime with REQUEST_DENIED. Launching
      // from VS Code's Run button used to pass no arguments at all, which is
      // exactly how that happened. Keep this flag on every configuration.
      "name": "homegrown (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "homegrown (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    },
    {
      "name": "homegrown (release)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "toolArgs": ["--dart-define-from-file=dart_defines.json"]
    }
  ]
}
