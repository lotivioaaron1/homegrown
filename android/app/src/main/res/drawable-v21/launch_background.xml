<?xml version="1.0" encoding="utf-8"?>
<!-- Shadows drawable/launch_background.xml on every device this app runs on
     (minSdk is 24), so this is the file that actually takes effect below API
     31. It used to resolve ?android:colorBackground, which is white in light
     mode — the white launch screen. Kept in step with the drawable/ copy. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
